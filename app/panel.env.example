# Copier en app/panel.env (hors git) et remplir.
# Sans HA_HOST, l'appli tourne en mode démo avec des valeurs simulées.

# Adresse de Home Assistant sur le réseau local, sans http://
HA_HOST=192.168.68.10
HA_PORT=8123

# Jeton d'accès longue durée : Home Assistant > Profil > Sécurité > Créer un jeton
HA_TOKEN=

# Cartes affichées, dans l'ordre, séparées par des virgules.
# Le type de carte vient du domaine :
#   light, switch, fan, input_boolean, automation, cover  -> bascule au toucher
#   sensor, binary_sensor                                  -> valeur
#   scene, script, button, input_button                    -> lancement au toucher
#   panel.test                                             -> page de test (transitions, i/s)
# Un nom peut remplacer celui de Home Assistant : entité=Nom
# Garder les guillemets simples dès qu'un nom contient un espace.
HA_CARDS='light.salon,switch.prise_bureau=Imprimante 3D,sensor.salon_temperature,scene.soiree'

# Fuseau horaire en notation POSIX : l'image Alpine n'a pas la base tzdata.
TZ=CET-1CEST,M3.5.0,M10.5.0/3

# Service de config (page Réglages : ordre, icône, masquage des cartes).
# 10.55.0.1 est l'hôte du câble USB par défaut. Sans service qui répond là,
# l'appli garde simplement l'ordre et l'affichage de HA_CARDS tels quels.
CONFIG_HOST=10.55.0.1
CONFIG_PORT=8787
